# Shared
JWT_SECRET=change-me-in-production
ML_INTERNAL_TOKEN=change-me-ml-token

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ML_SERVICE_URL=http://ml-service:9000
REDIS_URL=redis://redis:6379/0
S3_BUCKET=
AWS_REGION=us-east-1
MAX_GLOBAL_SESSIONS=10
MAX_USER_SESSIONS=2
DEMO_USERS=admin:admin123,demo:demo123

# ML service
ML_HOST=0.0.0.0
ML_PORT=9000
# onnx = YOLOv8n via ONNX Runtime (default, fast Docker build, ~500MB image)
# ultralytics = full PyTorch stack (slow build; use ml-service/Dockerfile.ultralytics)
# hog = OpenCV HOG only
DETECTOR=onnx
ONNX_MODEL_PATH=/app/models/yolov8n.onnx
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# Frontend
BACKEND_URL=http://backend:8000
FRAME_SAMPLE_RATE=3
STUN_SERVER=stun:stun.l.google.com:19302
