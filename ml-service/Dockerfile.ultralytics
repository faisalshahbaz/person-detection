# Optional heavy image (PyTorch + Ultralytics). Use: docker build -f Dockerfile.ultralytics .
FROM python:3.10-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
    --extra-index-url https://pypi.org/simple \
    torch==2.5.1+cpu

COPY requirements-ultralytics.txt requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-ultralytics.txt

COPY app/ ./app/

ENV DETECTOR=ultralytics
ENV YOLO_MODEL=yolov8n.pt
EXPOSE 9000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "9000"]
